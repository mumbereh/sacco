<h1 class="mb-4">All Transaction Reports</h1>

<div style="margin-bottom: 10px;">
  <%= link_to "New Transaction Report", new_transaction_report_path, class: "btn btn-primary" %>
</div>

<table class="styled-table">
  <thead>
    <tr>
      <th>ID</th>
      <th>From</th>
      <th>To</th>
      <th>Created At</th>
      <th>Action</th>
    </tr>
  </thead>
  <tbody>
    <% @transaction_reports.each do |report| %>
      <tr>
        <td><%= report.id %></td>
        <td><%= truncate(report.from.to_s, length: 30) %></td>
        <td><%= truncate(report.to.to_s, length: 30) %></td>
        <td><%= l(report.created_at, format: :short) %></td>
        <td><%= link_to "Details", transaction_report_path(report), class: "btn btn-sm btn-info" %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<style>
  .styled-table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.85rem;
    border: 1px solid #ccc;
    table-layout: fixed;
  }

  .styled-table th,
  .styled-table td {
    border: 1px solid #ccc;
    padding: 6px 8px;
    text-align: left;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  .styled-table thead {
    background-color: #f0f0f0;
    font-weight: bold;
  }

  .styled-table tbody tr:nth-child(even) {
    background-color: #fafafa;
  }

  .btn {
    padding: 4px 8px;
    font-size: 0.75rem;
    border-radius: 4px;
    text-decoration: none;
  }

  .btn-primary {
    background-color: #0d6efd;
    color: white;
    border: none;
  }

  .btn-info {
    background-color: #17a2b8;
    color: white;
    border: none;
  }

  .mb-4 {
    margin-bottom: 1rem;
  }
</style>
