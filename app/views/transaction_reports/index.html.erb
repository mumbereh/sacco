<h1 class="mb-4">All Transaction Reports</h1>

<%= link_to "New Transaction Report", new_transaction_report_path, class: "btn btn-primary mb-3" %>

<table class="styled-table">
  <thead>
    <tr>
      <th>ID</th>
      <th>From</th>
      <th>To</th>
      <th>Created At</th>
      <th colspan="3">Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @transaction_reports.each do |report| %>
      <tr>
        <td><%= report.id %></td>
        <td><%= report.from %></td>
        <td><%= report.to %></td>
        <td><%= l(report.created_at, format: :short) %></td>
        <td><%= link_to "Details", transaction_report_path(report), class: "btn btn-sm btn-info" %></td>
      </tr>
    <% end %>
  </tbody>
</table>
