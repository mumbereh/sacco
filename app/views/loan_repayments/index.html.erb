<h1 class="mb-4">Loan Repayments</h1>

<% if flash[:notice] %>
  <div class="alert alert-success"><%= flash[:notice] %></div>
<% elsif flash[:alert] %>
  <div class="alert alert-danger"><%= flash[:alert] %></div>
<% end %>

<table class="styled-table">
  <thead>
    <tr>
      <th>Loan ID</th>
      <th>Member</th>
      <th>Loan Type</th>
      <th>Payment Amount</th>
      <th>Outstanding Balance</th>
      <th>Payment Date</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @loan_repayments.each do |loan_repayment| %>
      <% loan = loan_repayment.loan %>
      <tr>
        <td><%= loan.id %></td>
        <td><%= loan.member.full_name %></td>
        <td><%= loan.loan_type %></td>
        <td><%= number_to_currency(loan_repayment.payment_amount, unit: "UGX ") %></td>
        <td><%= number_to_currency(loan.outstanding_balance, unit: "UGX ") %></td>
        <td><%= loan_repayment.payment_date.strftime("%B %d, %Y") %></td>
        <td>
          <%= link_to 'Show', loan_repayment_path(loan_repayment), class: 'btn btn-sm btn-info' %>
          <%= link_to 'Edit', edit_loan_repayment_path(loan_repayment), class: 'btn btn-sm btn-warning' %>
          <%= link_to 'Delete', loan_repayment_path(loan_repayment), method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-sm btn-danger' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="mt-3">
  <%= link_to 'New Loan Repayment', new_loan_repayment_path, class: 'btn btn-success' %>
</div>

<style>
  .styled-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
    font-size: 14px;
  }

  .styled-table th, .styled-table td {
    border: 1px solid #ccc;
    padding: 6px 8px;
  }

  .styled-table th {
    background-color: #f2f2f2;
    text-align: left;
  }

  .btn {
    padding: 4px 10px;
    margin: 2px;
    border-radius: 4px;
    text-decoration: none;
    font-size: 13px;
  }

  .btn-info { background-color: #17a2b8; color: white; }
  .btn-warning { background-color: orange; color: white; }
  .btn-danger { background-color: red; color: white; }
  .btn-success { background-color: green; color: white; margin-top: 10px; display: inline-block; }
</style>
