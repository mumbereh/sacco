<h1>Loan Repayment Details</h1>

<p><strong>Loan ID:</strong> <%= @loan_repayment.loan.id %></p>
<p><strong>Member Name:</strong> <%= @loan_repayment.loan.member.name %></p>
<p><strong>Payment Amount:</strong> <%= number_to_currency(@loan_repayment.payment_amount, unit: "UGX ") %></p>
<p><strong>Payment Date:</strong> <%= @loan_repayment.payment_date %></p>

<%= link_to 'Back to List', loan_repayments_path, class: 'btn btn-secondary' %>
<%= link_to 'Edit', edit_loan_repayment_path(@loan_repayment), class: 'btn btn-warning' %>
<%= link_to 'Delete', loan_repayment_path(@loan_repayment), method: :delete, data: { confirm: 'Are you sure you want to delete this repayment?' }, class: 'btn btn-danger' %>
