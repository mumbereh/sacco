<%= form_with(model: loan_repayment, local: true) do |form| %>
  <% if loan_repayment.errors.any? %>
    <div class="error-messages">
      <h2><%= pluralize(loan_repayment.errors.count, "error") %> prevented this repayment from being saved:</h2>
      <ul>
        <% loan_repayment.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :member_id, "Select Member" %>
    <%= form.collection_select :member_id, Member.all, :id, :name, prompt: "Choose a Member", class: "form-control", required: true %>
  </div>

  <div class="form-group">
    <%= form.label :loan_id, "Select Loan" %>
    <%= form.collection_select :loan_id, Loan.all, :id,
      ->(loan) {
        "##{loan.id} - #{loan.loan_type} (Outstanding: UGX #{number_with_delimiter(loan.outstanding_balance.to_i)})"
      },
      prompt: "Choose a Loan", class: "form-control", required: true %>
  </div>

  <div class="form-group">
    <%= form.label :payment_amount, "Payment Amount (UGX)" %>
    <%= form.number_field :payment_amount, step: 1000, min: 0, placeholder: "Enter amount", class: "form-control", required: true %>
  </div>

  <div class="form-group">
    <%= form.label :payment_date, "Payment Date" %>
    <%= form.date_select :payment_date, start_year: Date.today.year - 5, end_year: Date.today.year + 5, class: "form-control" %>
  </div>

  <div class="form-actions mt-3">
    <%= form.submit "Submit Repayment", class: "btn btn-primary" %>
  </div>
<% end %>
