<% content_for :title, "Accounts" %>

<h1>All Member Accounts</h1>

<% if @accounts.any? %>
  <table class="styled-table">
    <thead>
      <tr>
        <th>Account Number</th>
        <th>Member Name</th>
        <th>Membership Type</th>
        <th>Account Type</th>
        <th>Balance</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @accounts.each do |account| %>
        <tr>
          <td><%= account.account_number %></td>
          <td><%= account.member.name %></td>
          <td><%= account.member.membership_type %></td>
          <td><%= account.account_type %></td>
          <td><%= number_to_currency(account.balance, unit: "UGX ") %></td>
          <td>
            <%= link_to "🤝", account_path(account), class: "btn btn-info btn-sm" %>
            <%= link_to "Edit", edit_account_path(account), class: "btn btn-warning btn-sm" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No accounts have been created yet.</p>
<% end %>

<br>

<%= link_to "Create New Account", new_account_path, class: "btn btn-primary" %>
