<% content_for :title, "Accounts" %>

<h1>All Member Accounts</h1>

<% if @accounts.any? %>
  <table class="styled-table">
    <thead>
      <tr>
        <th>Account Number</th>
        <th>Member Name</th>
        <th>Membership Type</th>
        <th>Account Type</th>
        <th>Balance</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @accounts.each do |account| %>
        <tr>
          <td><%= account.account_number %></td>
          <td><%= account.member.full_name %></td>
          <td><%= account.member.membership_type %></td>
          <td><%= account.account_type %></td>
          <td><%= number_to_currency(account.balance, unit: "UGX ") %></td>
          <td class="actions">
            <%= link_to "Show", account_path(account), class: "btn btn-sm btn-info" %>
            <%= link_to "Edit", edit_account_path(account), class: "btn btn-sm btn-warning" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No accounts have been created yet.</p>
<% end %>

<br>

<%= link_to "Create New Account", new_account_path, class: "btn btn-primary" %>

<style>
  .styled-table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.85rem;
    border: 1px solid #ccc;
  }

  .styled-table th, .styled-table td {
    border: 1px solid #ccc;
    padding: 6px 10px;
    text-align: left;
  }

  .styled-table thead {
    background-color: #f0f0f0;
    font-weight: bold;
  }

  .styled-table tbody tr:nth-child(even) {
    background-color: #fafafa;
  }

  .btn {
    padding: 4px 8px;
    font-size: 0.75rem;
    border-radius: 4px;
    margin-right: 4px;
  }
</style>
