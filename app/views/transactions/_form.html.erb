<%= form_with(model: transaction, local: true) do |form| %>
  <% if transaction.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(transaction.errors.count, "error") %> prohibited this transaction from being saved:</h2>
      <ul>
        <% transaction.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :member_id %>
    <%= form.collection_select :member_id, Member.all, :id, :full_name, prompt: "Select Member" %>
  </div>

  <div>
    <%= form.label :account_id, "Source Account" %>
    <%= form.select :account_id, [], prompt: "Select Member First" %>
  </div>

  <div>
    <%= form.label :transaction_type %>
    <%= form.select :transaction_type, options_for_select(%w[deposit withdraw transfer], transaction.transaction_type), prompt: "Select Type" %>
  </div>

  <div>
    <%= form.label :amount %>
    <%= form.number_field :amount, step: 0.01 %>
  </div>

  <div id="recipient_fields" style="display: none;">
    <%= form.label :recipient_account_id, "Recipient Account (Select)" %>
    <%= form.select :recipient_account_id, [], include_blank: true %>

    <%= form.label :manual_recipient_account, "Manual Recipient Account (Fallback)" %>
    <%= form.text_field :manual_recipient_account, placeholder: "Enter Account Info" %>
  </div>

  <div>
    <%= form.submit %>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const memberSelect = document.querySelector("#transaction_member_id");
      const accountSelect = document.querySelector("#transaction_account_id");
      const typeField = document.querySelector("#transaction_transaction_type");
      const recipientFields = document.querySelector("#recipient_fields");
      const recipientSelect = document.querySelector("#transaction_recipient_account_id");

      let allAccounts = [];

      // Fetch all accounts once
      fetch("/accounts.json")
        .then(res => res.json())
        .then(data => {
          allAccounts = data;
        });

      function getMemberAccounts(memberId) {
        return allAccounts.filter(acc => acc.member_id == memberId);
      }

      function updateAccountOptions(memberId) {
        const accounts = getMemberAccounts(memberId);
        accountSelect.innerHTML = '<option value="">Select Account</option>';
        accounts.forEach(acc => {
          accountSelect.innerHTML += `<option value="${acc.id}">${acc.account_number}</option>`;
        });

        // Auto-fill if only one account
        if (accounts.length === 1) {
          accountSelect.value = accounts[0].id;
        }

        updateRecipientOptions();
      }

      function updateRecipientOptions() {
        const transactionType = typeField.value;
        const sourceAccountId = parseInt(accountSelect.value);
        const memberId = parseInt(memberSelect.value);

        if (transactionType === "transfer") {
          recipientFields.style.display = "block";

          const memberAccounts = getMemberAccounts(memberId).map(a => a.id);
          const filteredAccounts = allAccounts.filter(acc => !memberAccounts.includes(acc.id) && acc.id !== sourceAccountId);

          recipientSelect.innerHTML = '<option value="">Select Account</option>';
          filteredAccounts.forEach(acc => {
            recipientSelect.innerHTML += `<option value="${acc.id}">${acc.account_number}</option>`;
          });
        } else {
          recipientFields.style.display = "none";
        }
      }

      // Event bindings
      if (memberSelect) {
        memberSelect.addEventListener("change", () => {
          updateAccountOptions(memberSelect.value);
        });
      }

      if (typeField) {
        typeField.addEventListener("change", updateRecipientOptions);
      }

      if (accountSelect) {
        accountSelect.addEventListener("change", updateRecipientOptions);
      }

      // Run on load
      updateRecipientOptions();
    });
  </script>
<% end %>
