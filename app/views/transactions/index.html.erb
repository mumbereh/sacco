<h1 class="mb-4">Transactions</h1>

<% if flash[:notice] %>
  <div class="alert alert-success"><%= flash[:notice] %></div>
<% elsif flash[:alert] %>
  <div class="alert alert-danger"><%= flash[:alert] %></div>
<% end %>

<table class="styled-table">
  <thead>
    <tr>
      <th>ID</th>
      <th>Member</th>
      <th>Source Account</th>
      <th>Transaction Type</th>
      <th>Amount</th>
      <th>Recipient Account</th>
      <th>Balance After</th>
      <th>Created At</th>
      <th colspan="3">Actions</th>
    </tr>
  </thead>

  <tbody>
    <% @transactions.each do |t| %>
      <tr>
        <td><%= t.id %></td>
        <td><%= t.member&.full_name || "N/A" %></td>
        <td><%= t.account&.account_number || "N/A" %></td>
        <td><%= t.transaction_type.capitalize %></td>
        <td><%= number_to_currency(t.amount, unit: "UGX ") %></td>
        <td>
          <% if t.recipient_account.present? %>
            <%= t.recipient_account.account_number %>
          <% elsif t.manual_recipient_account.present? %>
            <%= t.manual_recipient_account %>
          <% else %>
            -
          <% end %>
        </td>
        <td><%= number_to_currency(t.balance_after_transaction, unit: "UGX ") %></td>
        <td><%= l(t.created_at, format: :short) %></td>
        <td><%= link_to "Show", transaction_path(t), class: "btn btn-sm btn-info" %></td>
        <td><%= link_to "Edit", edit_transaction_path(t), class: "btn btn-sm btn-warning" %></td>
        <td><%= link_to "Delete", transaction_path(t), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-sm btn-danger" %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="mt-3">
  <%= link_to "New Transaction", new_transaction_path, class: "btn btn-success" %>
</div>

<style>
  .styled-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
    line-height: 1.4;
  }

  .styled-table th,
  .styled-table td {
    border: 1px solid #ddd;
    padding: 6px 8px;
    text-align: left;
  }

  .styled-table th {
    background-color: #f4f4f4;
    font-weight: bold;
  }

  .styled-table tr:nth-child(even) {
    background-color: #fafafa;
  }

  .btn {
    padding: 2px 6px;
    font-size: 0.75rem;
  }

  .mb-4 {
    margin-bottom: 1.5rem;
  }

  .mt-3 {
    margin-top: 1rem;
  }
</style>
