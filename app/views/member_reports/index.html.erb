<!DOCTYPE html>
<html>
<head>
  <title>All Member Reports</title>
  <style>
    body {
      font-family: 'Segoe UI', Tahoma, sans-serif;
      background-color: #f7f9fc;
      color: #333;
      margin: 20px;
    }

    h1 {
      font-size: 1.8rem;
      color: #1a237e;
      margin-bottom: 1rem;
    }

    .btn {
      display: inline-block;
      padding: 8px 16px;
      border-radius: 6px;
      text-decoration: none;
      font-weight: 500;
      transition: background-color 0.3s ease;
    }

    .btn-primary {
      background-color: #007bff;
      color: #fff;
      margin-bottom: 1.2rem;
    }

    .btn-primary:hover {
      background-color: #0056b3;
    }

    .btn-info {
      background-color: #17a2b8;
      color: #fff;
    }

    .btn-info:hover {
      background-color: #117a8b;
    }

    .btn-sm {
      font-size: 0.8rem;
      padding: 5px 10px;
    }

    .table {
      width: 100%;
      border-collapse: collapse;
      background-color: #fff;
      border-radius: 8px;
      box-shadow: 0 0 12px rgba(0,0,0,0.05);
    }

    .table thead {
      background-color: #e3f2fd;
    }

    .table th,
    .table td {
      padding: 12px 16px;
      border-bottom: 1px solid #dee2e6;
      text-align: left;
    }

    .table th {
      color: #1a237e;
      font-weight: 600;
    }

    .table tbody tr:hover {
      background-color: #f1f9ff;
    }
  </style>
</head>

<body>
  <h1 class="mb-4">All Member Reports</h1>

  <%= link_to "New Member Report", new_member_report_path, class: "btn btn-primary" %>

  <table class="table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Member</th>
        <th>Created At</th>
        <th>Details</th>
      </tr>
    </thead>
    <tbody>
      <% @member_reports.each do |report| %>
        <tr>
          <td><%= report.id %></td>
          <td><%= report.member.full_name %></td>
          <td><%= l(report.created_at, format: :short) %></td>
          <td><%= link_to "View", member_report_path(report), class: "btn btn-info btn-sm" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</body>
</html>
