<div id="<%= dom_id loan_report %>">
  <p>
    <strong>Loan:</strong>
    <%= loan_report.loan_id %>
  </p>

  <p>
    <strong>Member name:</strong>
    <%= loan_report.member_name %>
  </p>

  <p>
    <strong>Amount:</strong>
    <%= loan_report.amount %>
  </p>

  <p>
    <strong>Interest rate:</strong>
    <%= loan_report.interest_rate %>
  </p>

  <p>
    <strong>Total amount after deduction:</strong>
    <%= loan_report.total_amount_after_deduction %>
  </p>

  <p>
    <strong>Repayment status:</strong>
    <%= loan_report.repayment_status %>
  </p>

  <p>
    <strong>Approval status:</strong>
    <%= loan_report.approval_status %>
  </p>

  <p>
    <strong>Status:</strong>
    <%= loan_report.status %>
  </p>

  <p>
    <strong>Total repaid:</strong>
    <%= loan_report.total_repaid %>
  </p>

  <p>
    <strong>Outstanding balance:</strong>
    <%= loan_report.outstanding_balance %>
  </p>

</div>
