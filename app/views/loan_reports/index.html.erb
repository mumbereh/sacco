<h1 style="font-family: Arial, sans-serif; color: #2c3e50; margin-bottom: 15px;">Loan Reports</h1>

<table style="
  width: 100%; 
  border-collapse: collapse; 
  font-family: Arial, sans-serif; 
  font-size: 14px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  border-radius: 8px; 
  overflow: hidden;
  table-layout: fixed;
">
  <thead style="background: #34495e; color: white; text-align: left;">
    <tr>
      <th style="padding: 10px 12px;">Member Name</th>
      <th style="padding: 10px 12px;">Loan Amount</th>
      <th style="padding: 10px 12px;">Interest Rate (%)</th>
      <th style="padding: 10px 12px;">Total with Interest</th>
      <th style="padding: 10px 12px;">Total Repaid</th>
      <th style="padding: 10px 12px;">Outstanding Balance</th>
      <th style="padding: 10px 12px;">Approval Status</th>
      <th style="padding: 10px 12px;">Repayment Status</th>
      <th style="padding: 10px 12px;">Loan Status</th>
    </tr>
  </thead>

  <tbody>
    <% @loan_reports.each do |report| %>
      <tr style="border-bottom: 1px solid #ddd; cursor: default; transition: background-color 0.2s;">
        <td style="padding: 8px 12px; color: #2c3e50; font-weight: 600; max-width: 150px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= truncate(report.member_name.to_s, length: 30) %></td>
        <td style="padding: 8px 12px; color: #27ae60; font-weight: 500;"><%= number_to_currency(report.amount) %></td>
        <td style="padding: 8px 12px; color: #7f8c8d; text-align: center;"><%= report.interest_rate %></td>
        <td style="padding: 8px 12px; color: #2980b9; font-weight: 500;"><%= number_to_currency(report.total_amount_after_deduction) %></td>
        <td style="padding: 8px 12px; color: #16a085; font-weight: 500;"><%= number_to_currency(report.total_repaid) %></td>
        <td style="padding: 8px 12px; color: #c0392b; font-weight: 600;"><%= number_to_currency(report.outstanding_balance) %></td>
        <td style="padding: 8px 12px; text-transform: capitalize; color: #34495e; font-weight: 500;"><%= report.approval_status.humanize %></td>
        <td style="padding: 8px 12px; color: #34495e; font-weight: 500; max-width: 120px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= truncate(report.repayment_status.to_s, length: 25) %></td>
        <td style="padding: 8px 12px; color: #34495e; font-weight: 500; max-width: 120px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;"><%= truncate(report.status.to_s, length: 25) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<style>
  tbody tr:hover {
    background-color: #f1f8ff;
  }
</style>
