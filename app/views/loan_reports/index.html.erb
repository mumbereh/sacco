<h1>Loan Reports</h1>

<table style="width: 100%; border-collapse: collapse; margin-top: 20px;">
  <thead>
    <tr style="background-color: #f5f5f5;">
      <th style="border: 1px solid #ccc; padding: 8px;">Member Name</th>
      <th style="border: 1px solid #ccc; padding: 8px;">Loan Amount</th>
      <th style="border: 1px solid #ccc; padding: 8px;">Interest Rate (%)</th>
      <th style="border: 1px solid #ccc; padding: 8px;">Total with Interest</th>
      <th style="border: 1px solid #ccc; padding: 8px;">Total Repaid</th>
      <th style="border: 1px solid #ccc; padding: 8px;">Outstanding Balance</th>
      <th style="border: 1px solid #ccc; padding: 8px;">Approval Status</th>
      <th style="border: 1px solid #ccc; padding: 8px;">Repayment Status</th>
      <th style="border: 1px solid #ccc; padding: 8px;">Loan Status</th>
    </tr>
  </thead>

  <tbody>
    <% @loan_reports.each do |report| %>
      <tr>
        <td style="border: 1px solid #ccc; padding: 8px;"><%= report.member_name %></td>
        <td style="border: 1px solid #ccc; padding: 8px;"><%= number_to_currency(report.amount) %></td>
        <td style="border: 1px solid #ccc; padding: 8px;"><%= report.interest_rate %></td>
        <td style="border: 1px solid #ccc; padding: 8px;"><%= number_to_currency(report.total_amount_after_deduction) %></td>
        <td style="border: 1px solid #ccc; padding: 8px;"><%= number_to_currency(report.total_repaid) %></td>
        <td style="border: 1px solid #ccc; padding: 8px;"><%= number_to_currency(report.outstanding_balance) %></td>
        <td style="border: 1px solid #ccc; padding: 8px;"><%= report.approval_status.humanize %></td>
        <td style="border: 1px solid #ccc; padding: 8px;"><%= report.repayment_status %></td>
        <td style="border: 1px solid #ccc; padding: 8px;"><%= report.status %></td>
      </tr>
    <% end %>
  </tbody>
</table>
