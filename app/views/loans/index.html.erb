<h1 style="font-family: Arial, sans-serif; color: #2c3e50; margin-bottom: 15px;">All Loans</h1>

<table style="
  width: 100%;
  border-collapse: collapse;
  font-family: Arial, sans-serif;
  font-size: 13px; /* Smaller text */
  border: 1px solid #ccc;
">
  <thead style="background-color: #2c3e50; color: white;">
    <tr>
      <th style="padding: 6px 8px; border: 1px solid #ccc;">Member</th>
      <th style="padding: 6px 8px; border: 1px solid #ccc;">Loan Type</th>
      <th style="padding: 6px 8px; border: 1px solid #ccc;">Amount</th>
      <th style="padding: 6px 8px; border: 1px solid #ccc;">Rate</th>
      <th style="padding: 6px 8px; border: 1px solid #ccc;">Months</th>
      <th style="padding: 6px 8px; border: 1px solid #ccc;">Status</th>
      <th style="padding: 6px 8px; border: 1px solid #ccc;">Approval Status</th>
      <th style="padding: 6px 8px; border: 1px solid #ccc;">Actions</th>
    </tr>
  </thead>

  <tbody>
    <% @loans.each_with_index do |loan, index| %>
      <tr style="background-color: <%= index.even? ? '#ffffff' : '#f9f9f9' %>;">
        <td style="padding: 6px 8px; border: 1px solid #ccc;"><%= loan.member&.full_name || "N/A" %></td>
        <td style="padding: 6px 8px; border: 1px solid #ccc;"><%= loan.loan_type %></td>
        <td style="padding: 6px 8px; border: 1px solid #ccc; color: #27ae60;"><%= number_with_delimiter(sprintf('%.2f', loan.amount)) %></td>
        <td style="padding: 6px 8px; border: 1px solid #ccc; text-align: center;"><%= loan.interest_rate %></td>
        <td style="padding: 6px 8px; border: 1px solid #ccc; text-align: center;"><%= loan.payment_period %></td>
        <td style="padding: 6px 8px; border: 1px solid #ccc;"><%= loan.status&.capitalize || "N/A" %></td>
        <td style="padding: 6px 8px; border: 1px solid #ccc;">
          <% status = loan.approval_status.to_s %>
          <%= case status
              when "pending"
                content_tag(:span, "Pending", style: "color: red; font-weight: 500;")
              when "loan_officer"
                content_tag(:span, "Loan Officer", style: "color: orange; font-weight: 500;")
              when "secretary"
                content_tag(:span, "Secretary", style: "color: blue; font-weight: 500;")
              when "chairperson"
                content_tag(:span, "Chairperson", style: "color: green; font-weight: 500;")
              when "approved"
                content_tag(:span, "Final", style: "color: green; font-weight: 500;")
              else
                status.titleize
              end %>
        </td>
        <td style="padding: 4px 6px; border: 1px solid #ccc;">
          <%= link_to 'Show', loan_path(loan), class: "btn btn-primary" %>
          <%= link_to 'Edit', edit_loan_path(loan), class: "btn btn-warning" %>
          <%= link_to 'Delete', loan, method: :delete, data: { confirm: 'Are you sure?' }, class: "btn btn-danger" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to 'New Loan Application', new_loan_path, class: "btn btn-success" %>

<style>
  .btn {
    padding: 4px 8px;
    margin: 2px;
    border-radius: 4px;
    text-decoration: none;
    font-size: 12px;
    font-weight: 600;
    display: inline-block;
    transition: background-color 0.2s ease;
  }

  .btn-primary {
    background-color: #007bff;
    color: white;
  }

  .btn-warning {
    background-color: #f39c12;
    color: white;
  }

  .btn-danger {
    background-color: #e74c3c;
    color: white;
  }

  .btn-success {
    background-color: #2ecc71;
    color: white;
    margin-top: 20px;
    font-size: 13px;
  }

  .btn:hover {
    opacity: 0.9;
  }
</style>
