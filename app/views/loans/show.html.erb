<h1>Loan Details</h1>

<% if notice.present? %>
  <p style="color: green"><%= notice %></p>
<% elsif alert.present? %>
  <p style="color: red"><%= alert %></p>
<% end %>

<table class="styled-table">
  <tr>
    <th>Member</th>
    <td><%= @loan.member&.name || "N/A" %></td>
  </tr>
  <tr>
    <th>Loan Type</th>
    <td><%= @loan.loan_type %></td>
  </tr>
  <tr>
    <th>Amount</th>
    <td><%= number_to_currency(@loan.amount) %></td>
  </tr>
  <tr>
    <th>Interest Rate</th>
    <td><%= @loan.interest_rate %> %</td>
  </tr>
  <tr>
    <th>Payment Period</th>
    <td><%= @loan.payment_period %> months</td>
  </tr>
  <tr>
    <th>Monthly Installment</th>
    <td><%= number_to_currency(@loan.monthly_installment_payment) %></td>
  </tr>
  <tr>
    <th>Total Payable Amount</th>
    <td><%= number_to_currency(@loan.total_amount_after_deduction) %></td>
  </tr>
  <tr>
    <th>Loan Start Date</th>
    <td><%= @loan.date_loan_taken&.strftime("%d %B %Y") %></td>
  </tr>
  <tr>
    <th>Loan End Date</th>
    <td><%= @loan.date_loan_end&.strftime("%d %B %Y") %></td>
  </tr>
  <tr>
    <th>Status</th>
    <td><%= @loan.status.capitalize %></td>
  </tr>
  <tr>
    <th>Approval Status</th>
    <td>
      <% case @loan.approval_status.to_s
         when "pending" %>
        <span style="color: red;">Pending Approval</span>
      <% when "loan_officer" %>
        <span style="color: orange;">Approved by Loan Officer</span>
      <% when "secretary" %>
        <span style="color: blue;">Approved by Secretary</span>
      <% when "chairperson" %>
        <span style="color: green;">Approved by Chairperson</span>
      <% when "approved" %>
        <span style="color: green;">Final Approval Granted</span>
      <% when "rejected" %>
        <span style="color: red;">Rejected</span>
      <% else %>
        <%= @loan.approval_status %>
      <% end %>
    </td>
  </tr>
</table>

<hr>

<div class="action-buttons">
  <% if !@loan.loan_officer_approved? %>
    <%= button_to "Approve as Loan Officer", approve_loan_path(@loan, officer: "loan_officer"), method: :patch %>
  <% elsif @loan.loan_officer_approved? && !@loan.secretary_approved? %>
    <%= button_to "Approve as Secretary", approve_loan_path(@loan, officer: "secretary"), method: :patch, class: "btn btn-info" %>
  <% elsif @loan.secretary_approved? && !@loan.chairperson_approved? %>
    <%= button_to "Approve as Chairperson", approve_loan_path(@loan, officer: "chairperson"), method: :patch, class: "btn btn-success" %>
  <% elsif @loan.loan_officer_approved? && @loan.secretary_approved? && @loan.chairperson_approved? && @loan.status != "approved" %>
    <%= button_to "Finalize Loan Approval", approve_loan_path(@loan, officer: "approved"), method: :patch, class: "btn btn-primary" %>
  <% end %>
</div>

<br>

<%= link_to "Back to Loans", loans_path, class: "btn btn-secondary" %>

<style>
  .styled-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
  }
  .styled-table th, .styled-table td {
    border: 1px solid #ccc;
    padding: 10px;
  }
  .styled-table th {
    background-color: #f4f4f4;
  }
  .btn {
    padding: 10px 15px;
    text-decoration: none;
    border-radius: 5px;
    margin: 5px;
  }
  .btn-warning { background: orange; color: white; }
  .btn-info { background: #17a2b8; color: white; }
  .btn-success { background: #28a745; color: white; }
  .btn-primary { background: #007bff; color: white; }
  .btn-secondary { background: #6c757d; color: white; }
</style>
